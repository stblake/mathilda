+/* Instrumentation for the scoping-cost study (scratch copy only). */
+#ifndef SCOPESTAT_H
+#define SCOPESTAT_H
+#include <stdint.h>
+#include <mach/mach_time.h>
+typedef struct {
+    uint64_t ss_top, ss_nodes, ss_fn, ss_rebuilt, ss_unch, ss_unch_roots, ss_sym, ss_sym_hit;
+    uint64_t ss_envlen_sum;     /* env length summed over symbol visits */
+    uint64_t ss_filter;         /* shadow filters built */
+    double   t_ss_mod, t_ss_with, t_ss_ren;
+    uint64_t mod_calls, mod_vars, with_calls, with_vars;
+    double   t_mod_pro, t_mod_epi, t_mod_free, t_with_free;
+    uint64_t rb_top, rb_nodes, rb_unch, rb_unch_roots, rb_rebuilt, rb_danger, rb_danger_nodes, rb_scope_seen, rb_renames;
+    double   t_rb, t_rb_danger, t_rb_rename;
+    uint64_t pf_calls, pf_nodes; double t_pf;
+} ScopeStat;
+extern ScopeStat g_ss;
+extern int g_ss_on;
+extern int g_ss_depth;     /* >0 while inside a timed region (nesting guard) */
+double ss_now(void);
+void ss_note_module_body(void* key, void* vars, void* body, uint64_t nodes);
+extern int g_p_symsum, g_p_rbsum, g_p_nobump, g_proto_nobump_now;
+extern uint64_t g_p_ss_skip, g_p_ss_store, g_p_rb_skip, g_p_rb_store, g_p_ss_sysloc;
+uint64_t ss_symbit(const char* name);
+#define SS_VALID (1ULL << 63)
+#define SS_BITS  ((1ULL << 55) - 1)
+extern int g_p_binder; extern uint64_t g_ss_epoch, g_p_epoch_bumps;
+void ss_register_binder(const char* canon_name);
+static inline int ss_ok(uint64_t s) {
+    if (!(s & SS_VALID)) return 0;
+    return !g_p_binder || ((s >> 55) & 0xFF) == (g_ss_epoch & 0xFF);
+}
+static inline uint64_t ss_mk(uint64_t bits) {
+    return SS_VALID | (g_p_binder ? ((g_ss_epoch & 0xFF) << 55) : 0) | bits;
+}
