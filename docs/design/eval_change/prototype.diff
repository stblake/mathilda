+#include "scopestat.h"
+#include "expr.h"
+#include "print.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "symtab.h"
+#include "attr.h"
+
+ScopeStat g_ss;
+int g_p_symsum, g_p_rbsum, g_p_nobump, g_proto_nobump_now;
+uint64_t g_p_ss_skip, g_p_ss_store, g_p_rb_skip, g_p_rb_store, g_p_ss_sysloc;
+int g_p_binder; uint64_t g_ss_epoch = 1, g_p_epoch_bumps;
+/* binder table: canonical name pointer -> bit index (round robin over 55 bits) */
+#define BT 65536
+static const char* bt_k[BT]; static unsigned char bt_v[BT]; static unsigned bt_next;
+static size_t bt_slot(const char* p) { uint64_t x = (uint64_t)(uintptr_t)p; x ^= x >> 33; x *= 0xff51afd7ed558ccdULL; x ^= x >> 33; return x & (BT - 1); }
+void ss_register_binder(const char* p) {
+    size_t i = bt_slot(p);
+    while (bt_k[i] && bt_k[i] != p) i = (i + 1) & (BT - 1);
+    if (bt_k[i]) return;
+    bt_k[i] = p; bt_v[i] = (unsigned char)(bt_next++ % 55);
+    g_ss_epoch++; g_p_epoch_bumps++;          /* summaries built without this bit are stale */
+}
+static int bt_get(const char* p) {
+    size_t i = bt_slot(p);
+    while (bt_k[i]) { if (bt_k[i] == p) return bt_v[i]; i = (i + 1) & (BT - 1); }
+    return -1;
+}
+uint64_t ss_symbit(const char* name) {
+    if (g_p_binder) {
+        SymbolDef* d0 = intern_symbol_node(name);
+        int b = bt_get(d0 ? d0->symbol_name : name);
+        return b < 0 ? 0 : (1ULL << b);
+    }
+    SymbolDef* d = intern_symbol_node(name);
+    if (d && (d->builtin_func || (d->attributes & ATTR_PROTECTED))) return 0;   /* exempt: builtins / Protected */
+    uint64_t x = (uint64_t)(uintptr_t)(d ? d->symbol_name : name);
+    x ^= x >> 33; x *= 0xff51afd7ed558ccdULL; x ^= x >> 33;
+    return 1ULL << (x % 63);
+} int g_ss_on = -1; int g_ss_depth = 0;
+static mach_timebase_info_data_t tb;
+double ss_now(void) {
+    if (!tb.denom) mach_timebase_info(&tb);
+    return (double)mach_absolute_time() * tb.numer / tb.denom * 1e-9;
+}
+#define HB 8192
+typedef struct { void* key; uint64_t calls, nodes; char* desc; } HB_t;
+static HB_t hb[HB];
+void ss_note_module_body(void* key, void* vars, void* body, uint64_t nodes) {
+    size_t h = ((uintptr_t)key >> 4) & (HB - 1);
+    for (int p = 0; p < HB; p++, h = (h + 1) & (HB - 1)) {
+        if (hb[h].key == key || !hb[h].key) {
+            if (!hb[h].key) {
+                hb[h].key = key;
+                /* locals only (names), then the start of the body */
+                char a[200]; a[0] = 0; Expr* v = (Expr*)vars;
+                for (size_t i = 0; i < v->data.function.arg_count; i++) {
+                    Expr* x = v->data.function.args[i];
+                    if (x->type == EXPR_FUNCTION && x->data.function.arg_count == 2) x = x->data.function.args[0];
+                    if (x->type == EXPR_SYMBOL) { size_t L = strlen(a); snprintf(a + L, sizeof a - L, "%s ", x->data.symbol.name); }
+                }
+                char* b = expr_to_string((Expr*)body);
+                char buf[300];
+                snprintf(buf, sizeof buf, "{%.110s} :: %.150s", a, b ? b : "?");
+                hb[h].desc = strdup(buf); free(b);
+            }
+            hb[h].calls++; hb[h].nodes += nodes; return;
+        }
+    }
+}
+static int cmpn(const void* a, const void* b) {
+    const HB_t* x = a; const HB_t* y = b;
+    return (y->nodes > x->nodes) - (y->nodes < x->nodes);
+}
+static void ss_report(void) {
+    if (g_ss_on != 1) return;
+    FILE* f = stderr;
+    fprintf(f, "\n==== SCOPESTAT ====\n");
+    fprintf(f, "Module calls %llu (locals %llu)  With calls %llu (bindings %llu)\n",
+        (unsigned long long)g_ss.mod_calls, (unsigned long long)g_ss.mod_vars,
+        (unsigned long long)g_ss.with_calls, (unsigned long long)g_ss.with_vars);
+    fprintf(f, "substitute_scoping: top %llu nodes %llu (fn %llu sym %llu sym_hits %llu) rebuilt %llu unchanged %llu unchanged_roots %llu avg_env_len %.2f filters %llu\n",
+        (unsigned long long)g_ss.ss_top, (unsigned long long)g_ss.ss_nodes, (unsigned long long)g_ss.ss_fn,
+        (unsigned long long)g_ss.ss_sym, (unsigned long long)g_ss.ss_sym_hit,
+        (unsigned long long)g_ss.ss_rebuilt, (unsigned long long)g_ss.ss_unch, (unsigned long long)g_ss.ss_unch_roots,
+        g_ss.ss_sym ? (double)g_ss.ss_envlen_sum / g_ss.ss_sym : 0.0, (unsigned long long)g_ss.ss_filter);
+    fprintf(f, "time: ss(Module) %.3f s  ss(With) %.3f s  ss(rename) %.3f s\n", g_ss.t_ss_mod, g_ss.t_ss_with, g_ss.t_ss_ren);
+    fprintf(f, "time: Module prologue(locals) %.3f s  epilogue(env+reclaim) %.3f s  free(body) %.3f s ; With free(body) %.3f s\n",
+        g_ss.t_mod_pro, g_ss.t_mod_epi, g_ss.t_mod_free, g_ss.t_with_free);
+    fprintf(f, "replace_bindings: top %llu nodes %llu rebuilt %llu unchanged %llu unchanged_roots %llu scopes_seen %llu danger_builds %llu danger_nodes %llu renames %llu\n",
+        (unsigned long long)g_ss.rb_top, (unsigned long long)g_ss.rb_nodes, (unsigned long long)g_ss.rb_rebuilt,
+        (unsigned long long)g_ss.rb_unch, (unsigned long long)g_ss.rb_unch_roots, (unsigned long long)g_ss.rb_scope_seen,
+        (unsigned long long)g_ss.rb_danger, (unsigned long long)g_ss.rb_danger_nodes, (unsigned long long)g_ss.rb_renames);
+    fprintf(f, "time: replace_bindings %.3f s (danger build %.3f s, capture-avoid rename %.3f s)\n", g_ss.t_rb, g_ss.t_rb_danger, g_ss.t_rb_rename);
+    fprintf(f, "pure Function named-arg subst: calls %llu nodes %llu time %.3f s\n",
+        (unsigned long long)g_ss.pf_calls, (unsigned long long)g_ss.pf_nodes, g_ss.t_pf);
+    fprintf(f, "PROTO: binder=%d epoch_bumps=%llu\n", g_p_binder, (unsigned long long)g_p_epoch_bumps);
+    fprintf(f, "PROTO: symsum=%d rbsum=%d nobump=%d  ss_skip %llu ss_store %llu ss_sys_local_calls %llu rb_skip %llu rb_store %llu\n",
+        g_p_symsum, g_p_rbsum, g_p_nobump, (unsigned long long)g_p_ss_skip, (unsigned long long)g_p_ss_store,
+        (unsigned long long)g_p_ss_sysloc, (unsigned long long)g_p_rb_skip, (unsigned long long)g_p_rb_store);
+    qsort(hb, HB, sizeof(HB_t), cmpn);
+    fprintf(f, "-- hottest Module bodies by nodes walked (key = binding-list node) --\n");
+    for (int i = 0; i < 25 && hb[i].key; i++)
+        fprintf(f, "%10llu nodes %7llu calls  %6.0f nodes/call  %s\n", (unsigned long long)hb[i].nodes,
+            (unsigned long long)hb[i].calls, (double)hb[i].nodes / hb[i].calls, hb[i].desc);
+}
+__attribute__((constructor)) static void ss_init(void) {
+    const char* e = getenv("MTH_SCOPESTAT");
+    g_ss_on = (e && *e == '1') ? 1 : 0;
+    e = getenv("MTH_P_SYMSUM"); g_p_symsum = e && *e == '1';
+    e = getenv("MTH_P_RBSUM");  g_p_rbsum = e ? atoi(e) : 0;
+    e = getenv("MTH_P_NOBUMP"); g_p_nobump = e && *e == '1';
+    e = getenv("MTH_P_BINDER"); g_p_binder = e && *e == '1';
+    atexit(ss_report);
+}
