[
 {
  "id": "GR6.458",
  "gr": "6.458",
  "page": 707,
  "status": "ok",
  "lhs": "Integrate[x^(1 - 2*nu)*Exp[alpha*x^2]*Sin[b*x]*Gamma[nu, alpha*x^2], {x, 0, Infinity}]",
  "rhs": [
   "Sqrt[Pi]*2^(-nu)*alpha^(nu - 1)*Gamma[3/2 - nu]*Exp[b^2/(8*alpha)]*ParabolicCylinderD[2*nu - 2, b/Sqrt[2*alpha]]"
  ],
  "conds": [
   "Abs[Arg[alpha]] < 3*Pi/2",
   "0 < Re[nu] < 1"
  ],
  "cite": "ET II 309(18)",
  "edition_note": "",
  "section": "6.45 The incomplete gamma function",
  "tex": "int_0^inf x^(1-2nu) exp(alpha x^2) sin(bx) Gamma(nu,alpha x^2) dx = pi^(1/2) 2^-nu alpha^(nu-1) Gamma(3/2-nu) exp(b^2/8alpha) D_{2nu-2}[b/(2alpha)^(1/2)]",
  "note": ""
 },
