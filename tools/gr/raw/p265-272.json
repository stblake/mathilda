  "lhs": "Integrate[x^(2*n + 1)*Sin[x], x]",
  "rhs": [
   "(2*n + 1)!*(Sum[(-1)^(k + 1)*x^(2*n - 2*k + 1)/(2*n - 2*k + 1)!, {k, 0, n}]*Cos[x] + Sum[(-1)^k*x^(2*n - 2*k)/(2*n - 2*k)!, {k, 0, n}]*Sin[x])"
  ],
  "conds": [
   "Element[n, Integers] && n >= 0"
  ],
  "cite": "",
  "edition_note": "",
  "section": "2.63 Powers of trigonometric functions combined with other powers",
  "tex": "int x^(2n+1) sin x dx = (2n+1)! {sum ... cos x + sum ... sin x}",
  "note": ""
 },
