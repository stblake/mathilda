/* Experiment 233 -- SIAM 100-digit HOLDOUT B for Problem 8 (Maxima column).
   The same statements as heat_times.m.  Maxima has no numerical summation
   to infinity, so each series is summed to a fixed number of terms (glue, as
   in experiment 173): 60 terms for the eigen-series (at the smallest t of
   any bracket, t = 0.012, term 35 of w is already below 1e-62) and 30 for
   the erfc image series of bc8.8 (term 6 is below 1e-62 for t <= 0.05).
   Root: find_root on the same bracket as the Python half (machine) and
   bf_find_root at fpprec 60 (wp50).  bc8.4 needs the zeros of J0, which
   Maxima has no built-in for: SKIP.  See heat_times.m. */
load("../harness.mac")$
load("../siam100_common.mac")$
require(["find_root", "bf_find_root"])$

w(t) := 4/%pi*sum((-1)^k/(2*k+1)*exp(-(2*k+1)^2*%pi^2*t/4), k, 0, 59)$
w1(t) := 4/%pi*sum((-1)^k/(2*k+1)*exp(-(2*k+1)^2*%pi^2*t), k, 0, 59)$
u2(t) := 1/2 - 2/%pi*sum((-1)^k/(2*k+1)*exp(-(2*k+1)^2*%pi^2*t), k, 0, 59)$
u5(t) := 1 + 2*sum((-1)^n*exp(-n^2*%pi^2*t), n, 1, 60)$
wb(t) := 8/%pi^2*sum(exp(-(2*k+1)^2*%pi^2*t/4)/(2*k+1)^2, k, 0, 59)$
u8(t) := 2*sum((-1)^n*erfc((2*n+1)/(4*sqrt(t))), n, 0, 29)$
v9(t) := 4/%pi*sum(sin((2*k+1)*%pi/4)/(2*k+1)*exp(-(2*k+1)^2*%pi^2*t), k, 0, 59)$

two(lab, g, lo, hi) := (
  vrun(sconcat(lab, " machine"), lambda([], find_root(g, t, lo, hi)), 10, 80),
  vrun(sconcat(lab, " wp50"), lambda([], block([fpprec : 60],
         bf_find_root(g, t, bfloat(lo), bfloat(hi)))), 48, 80))$

two("bc8.1", 5/4*(1 - w(t)^2) - 3/10, 0.1, 0.2)$
two("bc8.2", u2(t) - 1/4, 0.05, 0.15)$
two("bc8.3", 1 - w(t)^3 - 9/10, 0.3, 0.5)$
skip("bc8.4 machine", "BesselJZero")$
skip("bc8.4 wp50", "BesselJZero")$
two("bc8.5", u5(t) - 1/2, 0.1, 0.2)$
two("bc8.6", 5/4*(1 - wb(t)^2) - 1, 0.15, 0.35)$
two("bc8.7", 1 - w(t)*w1(t) - 1/2, 0.05, 0.15)$
two("bc8.8", u8(t) - 1/10, 0.02, 0.05)$
two("bc8.9", 1 - v9(t)^2 - 1/2, 0.02, 0.04)$
two("bc8.10", 5/4*(1 - w(t)^2) - 10^-6, 0.012, 0.025)$
quit()$
