/* Experiment 230 -- SIAM 100-digit holdout B for Problem 5 (Maxima column).
   The same statement as discrete_minimax.m (scored against the discrete
   minimax value E): Maxima has no global minimiser, so the machine rows use
   its derivative-free minimiser fmin_cobyla (unconstrained, from the zero
   polynomial, rhoend 1e-12), as in experiment 170, on the same max of M
   moduli (written as a numeric function of the coefficients).  No bigfloat minimiser: wp50 SKIP. */
load("../harness.mac")$
load("../siam100_common.mac")$
load(fmin_cobyla)$
require(["fmin_cobyla", "gamma", "bessel_j"])$

ratprint : false$
cv : [c0, c1, c2, c3, c4, c5, c6, c7, c8]$
av : [a0, a1, a2, a3, a4]$
bv : [b0, b1, b2, b3, b4]$

/* The objective max_k |f_k - p(x_k)| as a Maxima function of the
   coefficients: on numbers it evaluates numerically; on symbols it returns
   itself unevaluated (funmake), so fmin_cobyla gets an expression it can
   evaluate point-wise without Maxima simplifying a symbolic max of M terms.
   XS/FS hold the sample points and the f values (floats). */
objR([c]) := if every(numberp, c) then
    lmax(makelist(abs(FS[k] - c[1] - sum(c[j + 1]*XS[k]^j, j, 1, length(c) - 1)), k, 1, length(XS)))
  else funmake(objR, c)$
objC([c]) := block([m : length(c)/2],
  if every(numberp, c) then
    lmax(makelist(block([p : c[1] + %i*c[m + 1] + sum((c[j + 1] + %i*c[m + j + 1])*XS[k]^j, j, 1, m - 1)],
                    cabs(rectform(FS[k] - p))), k, 1, length(XS)))
  else funmake(objC, c))$

realObj(f, a, b, n, m) := (
  XS : makelist(float(a + (b - a)*k/(m - 1)), k, 0, m - 1),
  FS : makelist(float(f(a + (b - a)*k/(m - 1))), k, 0, m - 1),
  [apply(objR, makelist(cv[j + 1], j, 0, n)), makelist(cv[j + 1], j, 0, n)])$
cplxObj(f, n, m) := block([vars : append(makelist(av[j + 1], j, 0, n), makelist(bv[j + 1], j, 0, n))],
  XS : makelist(rectform(float(exp(2*%pi*%i*k/m))), k, 0, m - 1),
  FS : map(lambda([z], rectform(float(f(z)))), XS),
  [apply(objC, vars), vars])$

cob(FV) := block([r],
  r : fmin_cobyla(FV[1], FV[2], makelist(0.0, length(FV[2])),
                  'rhobeg = 0.5, 'rhoend = 1e-12, 'maxfun = 100000, 'iprint = 0),
  apply(if op(FV[1]) = objR then objR else objC, map(rhs, r[1])))$

runge(x) := 1/(1 + 25*x^2)$
j10(x) := bessel_j(0, 10*x)$
sq2(z) := sqrt(z + 2)$
gam2(z) := gamma(z + 2)$
probs : [[exp, -1, 1, 2, 101], [abs, -1, 1, 4, 201], [sqrt, 0, 1, 3, 101],
         [runge, -1, 1, 6, 201], [gamma, 1, 2, 3, 101], [atan, -1, 1, 5, 201],
         [j10, 0, 1, 8, 201]]$
cprobs : [[exp, 3, 64], [sq2, 2, 96], [gam2, 4, 128]]$

for k : 1 thru 7 do (
  vrun(sconcat("bc5.", k, " machine"),
       buildq([P : probs[k]], lambda([], cob(realObj(P[1], P[2], P[3], P[4], P[5])))), 10, 120),
  skip(sconcat("bc5.", k, " wp50"), "NMinimize"))$
for k : 8 thru 10 do (
  vrun(sconcat("bc5.", k, " machine"),
       buildq([P : cprobs[k - 7]], lambda([], cob(cplxObj(P[1], P[2], P[3])))), 10, 120),
  skip(sconcat("bc5.", k, " wp50"), "NMinimize"))$
quit()$
