-- Experiment 183 -- SIAM 100-Digit Challenge, Appendix D Problem 8 (FriCAS column).
-- FriCAS's NumericalQuadrature (romberg/simpson/trapezoidal) is one-dimensional
-- on a FINITE interval; every row here integrates over R^N (N = 10, 1, 2), so
-- all four rows are SKIP rather than a hand-made range truncation or a
-- hand-nested cubature.  See sobolev_constant.m.
)read ../siam100_common.input )quiet
vskip("d8.machine", "N-D quadrature")
vskip("d8.wp50", "N-D quadrature")
vskip("d8.machine c3R1", "infinite-range quadrature")
vskip("d8.machine c2R2", "infinite-range quadrature")
)quit
