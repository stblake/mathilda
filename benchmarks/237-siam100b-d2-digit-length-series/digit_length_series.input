-- Experiment 237 -- SIAM 100-Digit Challenge, holdout B for Appendix D problem 2 (FriCAS).
-- FriCAS has no numerical infinite-series summation: every row is a SKIP.  See digit_length_series.m.
)read ../siam100_common.input )quiet
vskip("bd2.1 machine", "nsum")
vskip("bd2.1 wp50", "nsum")
vskip("bd2.2 machine", "nsum")
vskip("bd2.2 wp50", "nsum")
vskip("bd2.3 machine", "nsum")
vskip("bd2.3 wp50", "nsum")
vskip("bd2.4 machine", "nsum")
vskip("bd2.4 wp50", "nsum")
vskip("bd2.5 machine", "nsum")
vskip("bd2.5 wp50", "nsum")
vskip("bd2.6 machine", "nsum")
vskip("bd2.6 wp50", "nsum")
vskip("bd2.7 machine", "nsum")
vskip("bd2.7 wp50", "nsum")
vskip("bd2.8 machine", "nsum")
vskip("bd2.8 wp50", "nsum")
vskip("bd2.9 machine", "nsum")
vskip("bd2.9 wp50", "nsum")
vskip("bd2.10 machine", "nsum")
vskip("bd2.10 wp50", "nsum")
)quit
