-- Experiment 222 -- SIAM 100-Digit Challenge holdout A, family hd17 (FriCAS column).
-- Nodal-line lengths of Dirichlet eigenfunctions: FriCAS has no PDE
-- eigensolver.  Every row is a SKIP.  See nodal_lines.m.
)read ../siam100_common.input )quiet
for k in 1..10 repeat (vskip(concat ["hd17.", string(k), " machine"], "NDEigensystem (FEM)"); vskip(concat ["hd17.", string(k), " wp50"], "NDEigensystem (FEM)"))
)quit
