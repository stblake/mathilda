-- Experiment 223 -- SIAM 100-Digit Challenge holdout A, family hd18 (FriCAS column).
-- Dirichlet eigenvalues of -Laplacian on planar regions: FriCAS has no PDE
-- eigensolver.  Every row is a SKIP.  See dirichlet_eigenvalues.m.
)read ../siam100_common.input )quiet
for k in 1..10 repeat (vskip(concat ["hd18.", string(k), " machine"], "NDEigenvalues (FEM)"); vskip(concat ["hd18.", string(k), " wp50"], "NDEigenvalues (FEM)"))
)quit
