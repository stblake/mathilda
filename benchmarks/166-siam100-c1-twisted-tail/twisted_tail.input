-- Experiment 166 -- SIAM 100-Digit Challenge, Problem 1 (FriCAS column).
-- FriCAS's numeric quadrature (NumericalQuadrature: romberg) needs a finite
-- integrand on a closed interval; the integrand is unbounded at 0, so the
-- idiomatic call is romberg on [eps, 1] with eps at the bottom of each
-- precision.  See twisted_tail.m.
)read ../siam100_common.input )quiet
fD(x:DoubleFloat):DoubleFloat == cos(log(x)/x)/x
t0 := nowms(); r := romberg(fD, 1.0e-12, 1.0, 1.0e-10, 1.0e-12, 5, 22); vcaseD("c1.machine", r.value, nowms() - t0, 10)
digits(60)$Float
fF(x:Float):Float == cos(log(x)/x)/x
t0 := nowms(); rF := romberg(fF, 1.0e-60, 1.0, 1.0e-50, 1.0e-50, 5, 22); vcaseF("c1.wp50", rF.value, nowms() - t0, 48)
)quit
