-- Experiment 199 -- SIAM 100-digit holdout A, family hc4 (FriCAS column).
-- FriCAS has no numerical minimiser at all: every row SKIPs, as in C4.
-- See global_minima.m.
)read ../siam100_common.input )quiet
vskip("hc4.1 machine", "NMinimize")
vskip("hc4.1 wp50", "NMinimize")
vskip("hc4.2 machine", "NMinimize")
vskip("hc4.2 wp50", "NMinimize")
vskip("hc4.3 machine", "NMinimize")
vskip("hc4.3 wp50", "NMinimize")
vskip("hc4.4 machine", "NMinimize")
vskip("hc4.4 wp50", "NMinimize")
vskip("hc4.5 machine", "NMinimize")
vskip("hc4.5 wp50", "NMinimize")
vskip("hc4.6 machine", "NMinimize")
vskip("hc4.6 wp50", "NMinimize")
vskip("hc4.7 machine", "NMinimize")
vskip("hc4.7 wp50", "NMinimize")
vskip("hc4.8 machine", "NMinimize")
vskip("hc4.8 wp50", "NMinimize")
vskip("hc4.9 machine", "NMinimize")
vskip("hc4.9 wp50", "NMinimize")
vskip("hc4.10 machine", "NMinimize")
vskip("hc4.10 wp50", "NMinimize")
)quit
