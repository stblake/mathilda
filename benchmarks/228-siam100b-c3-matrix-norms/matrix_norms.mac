/* Experiment 228 -- SIAM 100-digit holdout B for Problem 3 (Maxima column).
   The same statement as matrix_norms.m: the 2-norm of each section, from
   LAPACK dgesvd (load(lapack); singular values only) in doubles.  Maxima's
   lapack has no complex SVD (zgesvd): bc3.7 machine SKIPs.  Maxima has no
   bigfloat SVD: every wp50 row SKIPs. */
load("../harness.mac")$
load("../siam100_common.mac")$
load(lapack)$
require(["dgesvd"])$

ent(k, i, j, n) :=
  if k = 1 then 1/(i + j - 1)
  else if k = 2 then 1/(i + j - 1)!
  else if k = 3 then 1/(1 + (i - j)^2)
  else if k = 4 then (if j <= i then 1/i else 0)
  else if k = 5 then (if i >= j then 2^-(i - j) else (-1/3)^(j - i))
  else if k = 6 then 1/((i + j - 1)*(i + j - 2)/2 + j)
  else if k = 8 then (if j >= i - 1 then n + 1 - max(i, j) else 0)
  else if k = 9 then 1/(2^i + 3^j)
  else 1/sqrt(i + j - 1)$

secm(k, m, n) := genmatrix(lambda([i, j], float(ent(k, i, j, n))), m, n)$
nrm(k, m, n) := lmax(first(dgesvd(secm(k, m, n))))$

msz : [[500, 500], [40, 40], [400, 400], [500, 500], [400, 400], [500, 150], [300, 300], [300, 300], [150, 150], [1000, 1000]]$

for k : 1 thru 10 do (
  if k = 7 then skip("bc3.7 machine", "complex SVD")
  else vrun(sconcat("bc3.", k, " machine"),
            buildq([k, m : msz[k][1], n : msz[k][2]], lambda([], nrm(k, m, n))), 10, 60),
  skip(sconcat("bc3.", k, " wp50"), "bigfloat SVD"))$
quit()$
