/* Experiment 253 -- SIAM 100-digit SEALED HOLDOUT B, family D18 (Maxima column).
   Maxima has no PDE / FEM eigensolver on a region: every row is a SKIP.
   See dirichlet_eigenvalue.m. */
load("../harness.mac")$
load("../siam100_common.mac")$
for k : 1 thru 10 do (
  skip(sconcat("bd18.", k, " machine"), "NDEigenvalues"),
  skip(sconcat("bd18.", k, " wp50"), "NDEigenvalues"))$
quit()$
