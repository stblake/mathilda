-- Experiment 218 -- SIAM 100-Digit Challenge, holdout A, family d13 (FriCAS column).
-- Each case is a parameter search (find the initial value with a condition
-- at the final time) around an ODE solve.  FriCAS has a fixed-step rk4 but
-- no root finder for a general real function (solve/complexSolve are
-- polynomial only; Newton is not a built-in): every row is SKIP, as in
-- experiment 188.  See initial_value_shooting.m.
)read ../siam100_common.input )quiet
vskip("hd13.1 machine", "FindRoot")
vskip("hd13.1 wp50", "FindRoot")
vskip("hd13.2 machine", "FindRoot")
vskip("hd13.2 wp50", "FindRoot")
vskip("hd13.3 machine", "FindRoot")
vskip("hd13.3 wp50", "FindRoot")
vskip("hd13.4 machine", "FindRoot")
vskip("hd13.4 wp50", "FindRoot")
vskip("hd13.5 machine", "FindRoot")
vskip("hd13.5 wp50", "FindRoot")
vskip("hd13.6 machine", "FindRoot")
vskip("hd13.6 wp50", "FindRoot")
vskip("hd13.7 machine", "FindRoot")
vskip("hd13.7 wp50", "FindRoot")
vskip("hd13.8 machine", "FindRoot")
vskip("hd13.8 wp50", "FindRoot")
vskip("hd13.9 machine", "FindRoot")
vskip("hd13.9 wp50", "FindRoot")
vskip("hd13.10 machine", "FindRoot")
vskip("hd13.10 wp50", "FindRoot")
)quit
