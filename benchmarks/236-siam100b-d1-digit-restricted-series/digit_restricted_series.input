vskip("bd1.4 wp50", "numerical infinite sum")
vskip("bd1.5 machine", "numerical infinite sum")
vskip("bd1.5 wp50", "numerical infinite sum")
vskip("bd1.6 machine", "numerical infinite sum")
vskip("bd1.6 wp50", "numerical infinite sum")
vskip("bd1.7 machine", "numerical infinite sum")
vskip("bd1.7 wp50", "numerical infinite sum")
vskip("bd1.8 machine", "numerical infinite sum")
vskip("bd1.8 wp50", "numerical infinite sum")
vskip("bd1.9 machine", "numerical infinite sum")
vskip("bd1.9 wp50", "numerical infinite sum")
