-- Experiment 236 -- SIAM 100-Digit Challenge, holdout B for Appendix D problem 1 (FriCAS).
-- FriCAS has no numerical summation to infinity: every row is a SKIP.  See digit_restricted_series.m.
)read ../siam100_common.input )quiet
vskip("bd1.1 machine", "numerical infinite sum")
vskip("bd1.1 wp50", "numerical infinite sum")
