/* Experiment 208 -- SIAM 100-digit holdout A, family d3 (Maxima column).
   lbfgs (Maxima's only general minimiser) on the same symbolic energy, same
   coordinates and start as point_energy_family.m (as experiment 178); lbfgs
   differentiates the expression symbolically.  It works in double precision
   only, so every 50-digit row is a SKIP.  Cap 120 s per case. */
load("../harness.mac")$
load("../siam100_common.mac")$
load(lbfgs)$
require(["lbfgs"])$

ph1 : float(%pi*(3 - sqrt(5)))$
pt(k) := if k = 0 then [0, 0, 1]
         else if k = 1 then [sin(th[1])*cos(ph1), sin(th[1])*sin(ph1), cos(th[1])]
         else [sin(th[k])*cos(ph[k]), sin(th[k])*sin(ph[k]), cos(th[k])]$
pc(k) := if k = 0 then [1, 0] else [cos(t[k]), sin(t[k])]$
gk(kind, r2) := if kind = 'c then 1/sqrt(r2) else if kind = 'r2 then 1/r2
                else if kind = 'log then -log(r2)/2 else -sqrt(r2)$
hcase(i, npts, kind) := block([en, vars, x0, lab],
  lab : sconcat("hd3.", i, " machine"),
  if kind = 'circle then (
    en : sum(sum(gk('c, (pc(j) - pc(k)) . (pc(j) - pc(k))), k, j + 1, npts - 1), j, 0, npts - 2),
    vars : makelist(t[k], k, 1, npts - 1),
    x0 : makelist(float(2*%pi*(k/npts)^(3/2)), k, 1, npts - 1))
  else (
    en : sum(sum(gk(kind, (pt(j) - pt(k)) . (pt(j) - pt(k))), k, j + 1, npts - 1), j, 0, npts - 2),
    vars : append(makelist(th[k], k, 1, npts - 1), makelist(ph[k], k, 2, npts - 1)),
    x0 : append(makelist(float(acos(1 - 2*k/npts)), k, 1, npts - 1),
                makelist(float(k*ph1), k, 2, npts - 1))),
  vrun(lab, lambda([], subst(lbfgs(en, vars, x0, 1e-10, [-1, 0]), en)), 10, 120),
  skip(sconcat("hd3.", i, " wp50"), "lbfgs(bfloat)"))$
hcase(1, 5, 'c)$
hcase(2, 12, 'c)$
hcase(3, 8, 'c)$
hcase(4, 32, 'c)$
hcase(5, 20, 'r2)$
hcase(6, 30, 'log)$
hcase(7, 16, 'dist)$
hcase(8, 30, 'circle)$
hcase(9, 50, 'c)$
hcase(10, 72, 'c)$
quit()$
