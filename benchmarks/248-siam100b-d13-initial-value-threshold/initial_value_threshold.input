-- Experiment 248 -- SIAM 100-Digit Challenge holdout B for App. D Problem 13 (FriCAS column).
-- Every case is a search for an initial value around an ODE solve.  FriCAS
-- has a fixed-step rk4 but no event location and no root finder for a general
-- real function (solve/complexSolve are polynomial only; Newton is not a
-- built-in), so all rows are SKIP (as in exp. 188).
)read ../siam100_common.input )quiet
vskip("bd13.1 machine", "FindRoot")
vskip("bd13.2 machine", "FindRoot")
vskip("bd13.3 machine", "FindRoot")
vskip("bd13.4 machine", "FindRoot")
vskip("bd13.5 machine", "FindRoot")
vskip("bd13.6 machine", "FindRoot")
vskip("bd13.7 machine", "FindRoot")
vskip("bd13.8 machine", "FindRoot")
vskip("bd13.9 machine", "FindRoot")
vskip("bd13.10 machine", "FindRoot")
vskip("bd13.1 wp50", "FindRoot")
vskip("bd13.2 wp50", "FindRoot")
vskip("bd13.3 wp50", "FindRoot")
vskip("bd13.4 wp50", "FindRoot")
vskip("bd13.5 wp50", "FindRoot")
vskip("bd13.6 wp50", "FindRoot")
vskip("bd13.7 wp50", "FindRoot")
vskip("bd13.8 wp50", "FindRoot")
vskip("bd13.9 wp50", "FindRoot")
vskip("bd13.10 wp50", "FindRoot")
)quit
