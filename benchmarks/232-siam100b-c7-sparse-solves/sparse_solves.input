-- Experiment 232 -- SIAM 100-digit HOLDOUT B for Problem 7 (FriCAS column).
-- FriCAS has no sparse matrix type and no per-case time cap, so only the
-- dense machine rows with n <= 2047 are attempted (bc7.1, 4, 5, 7, 10):
-- Matrix(DoubleFloat) and the built-in solve(M, b)
-- (LinearSystemMatrixPackage), as in experiment 172.  The matrix is built
-- outside the timed statement.  Every wp50 row (a dense Float solve at
-- digits(60) runs for tens of minutes with no cap) and every machine row
-- with n >= 5000 (a dense n^2 DoubleFloat matrix and an O(n^3) solve) SKIP.
-- See sparse_solves.m.
)read ../siam100_common.input )quiet
primeBands(n:Integer, offs:List Integer, sup:Integer, sub:Integer):Matrix DoubleFloat == (M : Matrix DoubleFloat := new(n::NonNegativeInteger, n::NonNegativeInteger, 0); p : Integer := 2; for i in 1..n repeat (M(i, i) := p::DoubleFloat; p := nextPrime(p)); for o in offs repeat (for i in 1..(n - o) repeat (M(i, i + o) := sup::DoubleFloat; M(i + o, i) := sub::DoubleFloat)); M)
cayley(p:Integer):Matrix DoubleFloat == (M : Matrix DoubleFloat := new(p::NonNegativeInteger, p::NonNegativeInteger, 0); for i in 1..p repeat M(i, i) := 7; for v in 1..(p - 1) repeat (for g in [2, 3, 5] repeat (w := (g*v) rem p; M(v + 1, w + 1) := 1; M(w + 1, v + 1) := 1)); M)
tree(n:Integer):Matrix DoubleFloat == (M : Matrix DoubleFloat := new(n::NonNegativeInteger, n::NonNegativeInteger, 0); for i in 1..n repeat M(i, i) := (i = 1 => 3; 2*i <= n => 4; 2); for i in 1..((n - 1) quo 2) repeat (for c in [2*i, 2*i + 1] repeat (M(i, c) := -1; M(c, i) := -1)); M)
unitv(n:Integer, j:Integer):Vector DoubleFloat == (b : Vector DoubleFloat := new(n::NonNegativeInteger, 0); b(j) := 1; b)
M := primeBands(1000, [1], 1, 1); b := unitv(1000, 1)
t0 := nowms(); r := solve(M, b); vcaseD("bc7.1 machine", (r.particular :: Vector DoubleFloat)(1), nowms() - t0, 10)
vskip("bc7.1 wp50", "Matrix Float solve (dense, no cap)")
vskip("bc7.2 machine", "Matrix DoubleFloat (dense 10000^2)")
vskip("bc7.2 wp50", "Matrix Float (dense 10000^2)")
vskip("bc7.3 machine", "Matrix DoubleFloat (dense 20000^2)")
vskip("bc7.3 wp50", "Matrix Float (dense 20000^2)")
M := primeBands(2000, [j^2 for j in 1..44], 1, 1); b := unitv(2000, 1)
t0 := nowms(); r := solve(M, b); vcaseD("bc7.4 machine", (r.particular :: Vector DoubleFloat)(1), nowms() - t0, 10)
vskip("bc7.4 wp50", "Matrix Float solve (dense, no cap)")
M := primeBands(2000, [2^j for j in 0..10], 1, -1); b := unitv(2000, 1)
t0 := nowms(); r := solve(M, b); vcaseD("bc7.5 machine", (r.particular :: Vector DoubleFloat)(1), nowms() - t0, 10)
vskip("bc7.5 wp50", "Matrix Float solve (dense, no cap)")
vskip("bc7.6 machine", "Matrix DoubleFloat (dense 5000^2)")
vskip("bc7.6 wp50", "Matrix Float (dense 5000^2)")
M := cayley(2003); b := unitv(2003, 2)
t0 := nowms(); r := solve(M, b); vcaseD("bc7.7 machine", (r.particular :: Vector DoubleFloat)(2), nowms() - t0, 10)
vskip("bc7.7 wp50", "Matrix Float solve (dense, no cap)")
vskip("bc7.8 machine", "Matrix DoubleFloat (dense 27000^2)")
vskip("bc7.8 wp50", "Matrix Float (dense 27000^2)")
vskip("bc7.9 machine", "Matrix DoubleFloat (dense 22500^2)")
vskip("bc7.9 wp50", "Matrix Float (dense 22500^2)")
M := tree(2047); b := unitv(2047, 1)
t0 := nowms(); r := solve(M, b); vcaseD("bc7.10 machine", (r.particular :: Vector DoubleFloat)(1), nowms() - t0, 10)
vskip("bc7.10 wp50", "Matrix Float solve (dense, no cap)")
)quit
