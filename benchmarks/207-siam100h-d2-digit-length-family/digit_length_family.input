-- Experiment 207 -- SIAM 100-digit holdout A, family d2 (FriCAS column).
-- FriCAS has no numerical infinite-series summation: every row is a SKIP.  See digit_length_family.m.
)read ../siam100_common.input )quiet
vskip("hd2.1 machine", "nsum")
vskip("hd2.1 wp50", "nsum")
vskip("hd2.2 machine", "nsum")
vskip("hd2.2 wp50", "nsum")
vskip("hd2.3 machine", "nsum")
vskip("hd2.3 wp50", "nsum")
vskip("hd2.4 machine", "nsum")
vskip("hd2.4 wp50", "nsum")
vskip("hd2.5 machine", "nsum")
vskip("hd2.5 wp50", "nsum")
vskip("hd2.6 machine", "nsum")
vskip("hd2.6 wp50", "nsum")
vskip("hd2.7 machine", "nsum")
vskip("hd2.7 wp50", "nsum")
vskip("hd2.8 machine", "nsum")
vskip("hd2.8 wp50", "nsum")
vskip("hd2.9 machine", "nsum")
vskip("hd2.9 wp50", "nsum")
vskip("hd2.10 machine", "nsum")
vskip("hd2.10 wp50", "nsum")
)quit
