/* Experiment 245 -- holdout B for SIAM Appendix D Problem 10 (Maxima column).
   The Monte-Carlo statements of random_recurrences.m: the pair index from
   random(W) (W = total weight, state make_random_state(1)) mapped through
   the cumulative weights; machine: n = 10^6, float ratio recursion
   r <- a + b/r, exp(mean log r); wp50: exact integer x_n for n = 10^4, then
   bfloat(abs(x_n)^(1/n)) at fpprec 60.  As experiment 185. */
load("../harness.mac")$
load("../siam100_common.mac")$
require(["random", "bfloat"])$

C : [[[1, 1, 1, 1], [[1, 0], [2, 0], [3, 0], [4, 0]]],
     [[1, 1], [[3, 1], [3, -1]]],
     [[1, 2], [[3, 1], [3, -1]]],
     [[1, 1], [[1, 1], [1, 2]]],
     [[1, 1, 1], [[3, -1], [3, 0], [3, 1]]],
     [[1, 1], [[4, 2], [4, -2]]],
     [[1, 1], [[1, 1], [2, 1]]],
     [[1, 1], [[5, 3], [5, -3]]],
     [[1, 1], [[3, 2], [1, 2]]],
     [[1, 1, 1], [[1, 1], [2, 1], [3, 1]]]]$
needM : [2, 3, 3, 3, 3, 3, 3, 3, 2, 2]$
needW : [1, 2, 2, 2, 2, 2, 2, 2, 1, 1]$
/* table: draw u = random(W) -> pair; tab[u + 1] */
mktab(c) := apply(append, makelist(makelist(c[2][i], c[1][i]), i, 1, length(c[1])))$

for k : 1 thru 10 do block([ptab : mktab(C[k]), W],
  W : length(ptab),
  vrun(sconcat("bd10.", k, " machine"), lambda([], block([r : 1.0, acc : 0.0, n : 10^6, p],
    set_random_state(make_random_state(1)),
    for j : 1 thru n - 1 do (
      p : ptab[random(W) + 1],
      r : p[1] + p[2]/r,
      acc : acc + log(r)),
    exp(acc/n))), needM[k], 60),
  vrun(sconcat("bd10.", k, " wp50"), lambda([], block([x0 : 1, x1 : 1, t, p, n : 10^4, fpprec : 60],
    set_random_state(make_random_state(1)),
    for j : 1 thru n - 1 do (p : ptab[random(W) + 1], t : x1, x1 : p[1]*x1 + p[2]*x0, x0 : t),
    bfloat(abs(x1)^(1/n)))), needW[k], 60))$
quit()$
