/Testing/
tests/Testing/
tests/CTestTestfile.cmake
tests/bench_*
!tests/bench_*.c
tests/data/trager_stress_report.json

# ---------------------------------------------------------------------------
# Generated documentation and local-only artefacts
# ---------------------------------------------------------------------------
# Compile[] worked example — kept locally, deliberately not tracked. It is a
# ~200 KB bundle (rendered PDF + snapshot PNG) that no build, test or docs
# target consumes, so it only ever cost clone size.
docs/compile_example/

# Repo-root performance write-ups (evaluator / pattern-matcher, .md + rendered
# .pdf) are generated locally and deliberately not tracked.
MATHILDA_*_PERFORMANCE.md
MATHILDA_*_PERFORMANCE.pdf

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
# The benchmark venv (sympy etc.) is created on demand, never tracked.
benchmarks/.venv/

# ---------------------------------------------------------------------------
# Editor, OS and local AI-assistant tooling
# ---------------------------------------------------------------------------
.DS_Store
.code-review-graph/
# Only the shared project settings are tracked; agents, skills, commands,
# worktrees and per-user settings stay local.
.claude/*
!.claude/settings.json
.cursorrules
.windsurfrules
AGENTS.md
.kiro/
.opencode.json
.scaffolding/

# ---------------------------------------------------------------------------
